{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(date *)",
      "Bash(curl *)",
      "Bash(printenv *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(command -v jq *)",
      "Bash(rm -f /tmp/*)",
      "Bash(aws --profile * sts get-caller-identity*)",
      "Bash(aws --profile * sso login*)",
      "Bash(aws configure list-profiles)"
    ],
    "defaultMode": "plan"
  },
  "attribution": {
    "sessionUrl": false
  }
}
